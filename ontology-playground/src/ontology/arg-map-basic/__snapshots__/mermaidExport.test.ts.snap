// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`mermaidExport > matches the generated-mermaid snapshot for the session-storage example 1`] = `
"flowchart BT
  i1["💡 Use Redis"]:::claim
  n1["✅ Fast, battle-tested"]:::support
  c1["⛔ Another service to operate"]:::critique
  n2["⛔ We have many services already, we're efficient at setting up another one"]:::critique
  i2["💡 Use Postgres rows"]:::claim
  n3["✅ One less dependency"]:::support
  n4["⛔ Slower for hot reads"]:::critique
  n5["💡 Use a worker queue"]:::claim
  n6[/"📝 worker queues hit the same operational cost"/]:::note
  n6 -.-> n5
  n1 --> i1
  c1 --> i1
  n2 --> c1
  n3 --> i2
  n4 --> i2
  c1 --> n5
  classDef claim fill:#ffeee3,stroke:#d97706,color:#502600,stroke-width:1.5px
  classDef support fill:#e9f3fe,stroke:#2166ac,color:#0e345a,stroke-width:1.5px
  classDef critique fill:#ffedec,stroke:#b2182b,color:#600d15,stroke-width:1.5px
  classDef note fill:#fcf2d3,stroke:#d3ad20,color:#3f3100,stroke-width:1.5px"
`;
