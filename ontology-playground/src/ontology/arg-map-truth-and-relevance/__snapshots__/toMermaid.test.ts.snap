  more_judges["💬 Hiring more immigration judges would cut illegal immigration more cheaply than a wall<br/>[6,7,3]"]:::claim
  reduction_supports_wall(["✅ supports<br/>[8,2,8]"]):::supports
  barrier_supports_reduction(["✅ supports<br/>[8,3,8]"]):::supports
  l1(["⛔ critiques<br/>[7,8,6]"]):::critiques
