// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`toMermaid > matches the generated-mermaid snapshot for the session-storage example 1`] = `
"flowchart BT
  q1{{"❓ How should we handle session storage?"}}:::question
  i1["💡 Use Redis"]:::idea
  n1["✅ Fast, battle-tested"]:::pro
  c1["⛔ Another service to operate"]:::con
  n2["⛔ We have many services already, we're efficient at setting up another one"]:::con
  i2["💡 Use Postgres rows"]:::idea
  n3["✅ One less dependency"]:::pro
  n4["⛔ Slower for hot reads"]:::con
  q2{{"❓ How do we run background jobs?"}}:::question
  n5["💡 Use a worker queue"]:::idea
  n6[/"📝 worker queues hit the same operational cost"/]:::note
  q3{{"❓ Which broker?"}}:::question
  i1 --> q1
  n1 --> i1
  c1 --> i1
  n2 --> c1
  i2 --> q1
  n3 --> i2
  n4 --> i2
  n5 --> q2
  n6 -.-> n5
  q3 --> n5
  c1 --> n5
  classDef question fill:#f2f0ff,stroke:#7c3aed,color:#3a1477,stroke-width:1.5px
  classDef idea fill:#ffefda,stroke:#ca8a04,color:#462d00,stroke-width:1.5px
  classDef pro fill:#e9f3fe,stroke:#2166ac,color:#0e345a,stroke-width:1.5px
  classDef con fill:#ffedec,stroke:#b2182b,color:#600d15,stroke-width:1.5px
  classDef note fill:#edf2fa,stroke:#64748b,color:#2b3340,stroke-width:1.5px"
`;
